<?xml version="1.0" encoding="utf-8"?>
<!--
   Copias de seguridad en Android 11 o anterior.
   No se respaldan el token de sesión (DataStore) ni la caché local (Room): al restaurar en
   otro teléfono el usuario vuelve a iniciar sesión y los datos se descargan de la API.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/sesion_finanzas_g7.preferences_pb" />
    <exclude domain="database" path="finanzas_g7.db" />
</full-backup-content>
