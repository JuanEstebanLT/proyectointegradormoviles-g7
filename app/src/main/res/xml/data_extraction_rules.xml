<?xml version="1.0" encoding="utf-8"?>
<!--
   Copias de seguridad en Android 12 o superior (nube y transferencia entre dispositivos).
   El token de sesión y la caché local no salen del teléfono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion_finanzas_g7.preferences_pb" />
        <exclude domain="database" path="finanzas_g7.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion_finanzas_g7.preferences_pb" />
        <exclude domain="database" path="finanzas_g7.db" />
    </device-transfer>
</data-extraction-rules>
